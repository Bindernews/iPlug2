{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default-linux",
      "displayName": "Default Configuration (Linux)",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "binaryDir": "${sourceDir}/build-default/",
      "cacheVariables": {
        "IPLUG_APP_JACK": "OFF",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "default-windows",
      "displayName": "Default Configuration (Windows)",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build-default/",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "web",
      "displayName": "Web Audio Module",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-web/",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
        "CMAKE_CROSSCOMPILING_EMULATOR": "$env{EMSDK_NODE}"
      }
    }
  ]
}
